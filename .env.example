# 실행 모드: paper(모의, 기본) | live(실거래)
MODE=paper
# live 모드는 아래 값이 YES일 때만 실제 주문을 냅니다
LIVE_CONFIRM=NO

# 빗썸 API 키 (live 모드에서만 필요. 출금 권한은 주지 마세요)
BITHUMB_ACCESS_KEY=
BITHUMB_SECRET_KEY=

MARKET=KRW-BTC
# 판단 봉 단위(분): 1,3,5,10,15,30,60,240
CANDLE_UNIT=240

# 진입 전략: score(지표 점수) | breakout(돌파) | structure(구조·분할) | defensive(방어형, 실험)
STRATEGY=score
# structure는 분할매수 기본 사용, score/breakout은 기본 미사용. 명시 시 true/false
# SCALE_IN=true
FIRST_BUY_RATIO=0.4
# 시장 국면 필터: btc(BTC 종가가 N일 평균 아래면 신규 매수 안 함) | off
REGIME_FILTER=btc
REGIME_DAYS=20

# 비용 가정 (계정 등급·쿠폰에 맞게 수정)
# 계정 요율 0.04% (2026-10-27 사용자 확인). 요율이 바뀌면 여기와 서버 .env를 함께 고친다.
FEE_RATE=0.0004
SLIPPAGE=0.0005

# 모의투자 시작 원화
PAPER_KRW=10000000

# 진입·청산 점수
ENTRY_SCORE=35
EXIT_SCORE=20

# 손절가: 진입가 - ATR x STOP_ATR (최근 10봉 저점 아래와 비교해 더 가까운 쪽, 최소 1 ATR)
STOP_ATR=2.5
# 이탈 신호가 나와도 바로 팔지 않고, 이탈 봉 종가 - ATR x BREACH_ATR 를 손절가로 설정
BREACH_ATR=1.0

# 목표가(매도가): 위험폭 R = 진입가 - 손절가
T1_R=2
T2_R=4
# 1차 목표가에서 매도할 비율
T1_SELL_RATIO=0.5
# 저항선 때문에 목표가까지 여유가 이 손익비보다 작으면 진입하지 않음
MIN_RR=1.5
MAX_HOLD_BARS=40

# 거래당 최대 손실(자본 대비), 1회 최대 매수 금액
RISK_PER_TRADE=0.02
MAX_POSITION_KRW=1000000
MIN_ORDER_KRW=5000

# 계좌 보호
DAILY_LOSS_LIMIT=0.03
KILL_SWITCH_LOSS=0.15

# 현재가 확인 주기(초)
PRICE_POLL_SEC=5

HOST=127.0.0.1
PORT=8787

# 손실 청산 후 재진입 대기 봉 수(0=끔, paper 전용 실험)
LOSS_COOLDOWN_BARS=0
